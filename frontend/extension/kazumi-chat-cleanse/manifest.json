{
  "manifest_version": 3,
  "name": "Kazumi Viewer Companion",
  "version": "0.1.0",
  "description": "Personal chat cleanse + client-side audio leveling for Twitch and YouTube.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.twitch.tv/*",
    "https://www.youtube.com/*",
    "http://localhost:8000/*",
    "https://*.kazumi.ai/*"
  ],
  "action": {
    "default_title": "Kazumi Chat Cleanse",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
